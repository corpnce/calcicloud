---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteName, tagline } from '@/config/site';

const faviconSvg = `${import.meta.env.BASE_URL}favicon.svg`;

interface Props {
  title: string;
  description?: string;
  noJsonLd?: boolean;
}

const { title, description = tagline, noJsonLd } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;

const basePrefix = import.meta.env.BASE_URL;
const ogAssetPath =
  basePrefix === '/' ? '/og-cover.svg' : `${basePrefix.replace(/\/?$/, '')}/og-cover.svg`;
const ogAbsolute = Astro.site ? new URL(ogAssetPath, Astro.site.origin).href : undefined;

const siteOrigin = Astro.site ? new URL(basePrefix === '/' ? './' : basePrefix, Astro.site).href : canonical;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  description,
  url: siteOrigin,
  areaServed: 'Worldwide',
  serviceType: ['Cloud Consulting', 'DevOps consulting', 'Cloud & DevOps training'],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a61f1f" />
    <meta
      name="keywords"
      content="cloud consulting, devops consultant, kubernetes, terraform, aws, azure, gcp, sre training, platform engineering, calcicloud"
    />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogAbsolute ? <meta property="og:image" content={ogAbsolute} /> : null}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogAbsolute ? <meta property="twitter:image" content={ogAbsolute} /> : null}

    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={faviconSvg} />

    {!noJsonLd ? <script type="application/ld+json" set:html={JSON.stringify(schema)} /> : null}
  </head>
  <body class="min-h-dvh bg-cream text-ink selection:bg-brand/20">
    <a
      href="#main"
      class="focus:bg-brand focus:text-cream sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
