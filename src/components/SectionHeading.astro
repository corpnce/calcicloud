---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  /** Sets `id` on the `<h2>` for `aria-labelledby` on parent sections */
  headingId?: string;
}

const { eyebrow, title, lead, align = 'left', headingId } = Astro.props;

const alignment = align === 'center' ? 'text-center mx-auto max-w-3xl' : 'max-w-3xl';
---

<div class:list={['space-y-4', alignment]}>
  {
    eyebrow ? (
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand"><span class="inline-block h-1 w-6 rounded-sm bg-accent-yellow mr-2 align-middle" aria-hidden="true"></span>{eyebrow}</p>
    ) : null
  }
  <h2 id={headingId} class="font-serif-display text-3xl tracking-tight text-ink md:text-4xl lg:text-5xl">{title}</h2>
  {lead ? <p class="text-lg leading-relaxed text-ink-muted md:text-xl">{lead}</p> : null}
</div>
