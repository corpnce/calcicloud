---
import { siteName } from '@/config/site';
import { route } from '@/lib/routes';

const trainingTopics = [
  { label: 'Architecture Studio', id: 'track-01' },
  { label: 'DevOps & Platform Lab', id: 'track-02' },
  { label: 'SRE & Cognitive Ops', id: 'track-03' },
  { label: 'Skills Gap Research', id: 'skills-gap' },
] as const;

const trainingBase = route('training/');

const navItemClass =
  'rounded-full px-4 py-2 text-sm font-medium text-ink-muted transition-all duration-200 hover:bg-warm-sand hover:text-ink';

const summaryClassDesktop =
  'flex cursor-pointer list-none items-center gap-1 rounded-full px-4 py-2 text-sm font-medium text-ink-muted transition-all duration-200 hover:bg-warm-sand hover:text-ink [&::-webkit-details-marker]:hidden';
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-cream/90 backdrop-blur-xl supports-[backdrop-filter]:bg-cream/75">
  <div class="mx-auto flex h-[74px] max-w-7xl items-center justify-between px-4 md:px-6 lg:px-8">

    <!-- Logo -->
    <a
      href={route('')}
      aria-label={siteName}
      class="inline-flex shrink-0 items-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
    >
      <img
        src={route('logo.png')}
        alt={siteName}
        class="h-auto w-[150px] object-contain sm:w-[170px] md:w-[205px]"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      <a
        href={route('consulting/')}
        class={navItemClass}
      >
        Consulting
      </a>

      <!-- Training Dropdown -->
      <div id="training-group" class="group/training relative py-3 -my-3" data-open="false">
        <a
          href={trainingBase}
          aria-haspopup="true"
          aria-expanded="false"
          class={summaryClassDesktop}
        >
          Training
          <span
            class="text-[10px] text-accent-yellow transition-transform duration-200 group-hover/training:rotate-180"
            aria-hidden="true"
          >
            ▾
          </span>
        </a>

          <div
            role="menu"
            aria-label="Training programs"
            class="pointer-events-none invisible absolute left-0 top-full z-50 mt-1 w-72 overflow-hidden rounded-2xl border border-ink/10 bg-cream/95 p-2 opacity-0 shadow-2xl ring-1 ring-black/5 backdrop-blur-xl transition-all duration-200 ease-out"
          >
          <a
            role="menuitem"
            href={trainingBase}
            class="block rounded-xl px-4 py-3 text-sm font-semibold text-brand transition hover:bg-warm-sand"
          >
            Training Overview
          </a>

          <div class="my-2 h-px bg-ink/8"></div>

          {
            trainingTopics.map((topic) => (
              <a
                role="menuitem"
                href={`${trainingBase}#${topic.id}`}
                class="block rounded-xl px-4 py-3 text-sm text-ink-muted transition hover:bg-warm-sand hover:text-ink"
              >
                {topic.label}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={route('about/')}
        class={navItemClass}
      >
        About
      </a>

      <a
        href={route('contact/')}
        class={navItemClass}
      >
        Contact
      </a>

      <!-- CTA -->
      <a
        href={route('contact/')}
        class="ml-3 inline-flex items-center justify-center rounded-full border border-accent/55 bg-brand px-5 py-2.5 text-sm font-semibold text-cream shadow-sm ring-accent-yellow transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-deep hover:shadow-[0_16px_36px_rgb(255_200_92_/_0.16)]"
      >
        Book a call
      </a>
    </nav>

    <!-- Mobile Menu -->
    <details class="relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-ink/10 bg-warm-sand/80 px-4 py-2 text-sm font-semibold text-ink transition hover:bg-warm-sand [&::-webkit-details-marker]:hidden"
      >
        Menu
        <span class="text-accent-yellow text-xs" aria-hidden="true">▾</span>
      </summary>

      <div
        class="absolute right-0 mt-3 w-64 space-y-1 rounded-2xl border border-ink/10 bg-cream/95 p-2 shadow-2xl ring-1 ring-black/5 backdrop-blur-xl"
        role="navigation"
        aria-label="Mobile navigation"
      >
        <a
          href={route('consulting/')}
          class="block rounded-xl px-4 py-3 text-sm font-medium text-ink transition hover:bg-warm-sand"
        >
          Consulting
        </a>

        <details class="rounded-xl open:bg-warm-sand/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="cursor-pointer rounded-xl px-4 py-3 text-sm font-medium text-ink transition hover:bg-warm-sand">
            Training ▾
          </summary>

          <div class="mt-1 space-y-1 border-t border-ink/8 pt-2">
            <a
              href={trainingBase}
              class="block rounded-lg px-5 py-2 text-sm font-semibold text-brand transition hover:bg-warm-sand"
            >
              Overview
            </a>

            {
              trainingTopics.map((topic) => (
                <a
                  href={`${trainingBase}#${topic.id}`}
                  class="block rounded-lg px-5 py-2 text-sm text-ink-muted transition hover:bg-warm-sand hover:text-ink"
                >
                  {topic.label}
                </a>
              ))
            }
          </div>
        </details>

        <a
          href={route('about/')}
          class="block rounded-xl px-4 py-3 text-sm font-medium text-ink transition hover:bg-warm-sand"
        >
          About
        </a>

        <a
          href={route('contact/')}
          class="block rounded-xl px-4 py-3 text-sm font-medium text-ink transition hover:bg-warm-sand"
        >
          Contact
        </a>

        <a
          href={route('contact/')}
          class="mt-2 block rounded-xl border border-accent/55 bg-brand px-4 py-3 text-center text-sm font-semibold text-cream shadow-[0_10px_24px_rgb(255_200_92_/_0.12)] transition hover:bg-brand-deep"
        >
          Book a call
        </a>
      </div>
    </details>
  <script type="module">
    // Training dropdown: toggle on click, close on outside click or Escape
    (function(){
      const group = document.getElementById('training-group');
      if(!group) return;
      const trigger = group.querySelector('[aria-haspopup="true"]');
      const menu = group.querySelector('[role="menu"]');
      if(!trigger || !menu) return;

      function open(){
        group.setAttribute('data-open','true');
        menu.classList.remove('pointer-events-none','invisible','opacity-0');
        menu.classList.add('pointer-events-auto','visible','opacity-100');
        trigger.setAttribute('aria-expanded','true');
      }
      function close(){
        group.setAttribute('data-open','false');
        menu.classList.add('pointer-events-none','invisible','opacity-0');
        menu.classList.remove('pointer-events-auto','visible','opacity-100');
        trigger.setAttribute('aria-expanded','false');
      }

      trigger.addEventListener('click', function(e){
        e.preventDefault();
        const openState = group.getAttribute('data-open') === 'true';
        if(openState) close(); else open();
      });

      document.addEventListener('click', function(e){
        if(!group.contains(e.target)) close();
      }, { capture: true });

      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape') close();
      });
    })();
  </script>
  </div>
</header>
